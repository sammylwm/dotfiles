layout {

    focus-ring {
        active-color   "#7467e4"
        inactive-color "#1b1a23"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#7467e4"
        inactive-color "#1b1a23"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#1b1a2370"
    }

    tab-indicator {
        active-color   "#7467e4"
        inactive-color "#190c8d"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#7467e480"
    }
}

recent-windows {
    highlight {
        active-color "#7467e4"
        urgent-color "#fd4663"
    }
}
